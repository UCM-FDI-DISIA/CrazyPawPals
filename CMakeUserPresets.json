{
    "version": 3,
    "configurePresets": [
        {
            "name": "x64-Debug-Clang",
            "inherits": "x64-Debug",
            "generator": "Ninja",
            "environment": {
                "DBG_NETWORK": "false"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER": "clang"
            }
        },
        {
            "name": "x64-Debug-Clang-Host",
            "inherits": "x64-Debug-Clang",
            "environment": {
                "DBG_NETWORK": "true",
                "DBG_NETWORK_HOST": "true",
                "DBG_NETWORK_CLIENT": "false"
            }
        },
        {
            "name": "x64-Debug-Clang-Client",
            "inherits": "x64-Debug-Clang",
            "environment": {
                "DBG_NETWORK": "true",
                "DBG_NETWORK_HOST": "false",
                "DBG_NETWORK_CLIENT": "true"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "x64-Debug-Clang",
            "configurePreset": "x64-Debug-Clang"
        },
        {
            "name": "x64-Debug-Clang-Host",
            "configurePreset": "x64-Debug-Clang-Host"
        },
        {
            "name": "x64-Debug-Clang-Client",
            "configurePreset": "x64-Debug-Clang-Client"
        }
    ]
}